# ==============================================================================
# Irmin Connectors — Environment Variables
# ==============================================================================
# All variables below are runtime configuration, loaded once at process startup
# via godotenv and validated in utils/loadEnvs.go. There are no build-time vars.
# ==============================================================================

# Server
PORT=8080                                    # Port to run the connectors server on
URL=http://localhost:8080                    # URL of the connectors server (defaults to http://localhost:$PORT)

# HTTP hardening
HELMET_ENABLED=false                         # Enable Helmet security headers
CORS_ENABLED=false                           # Enable CORS
CORS_ORIGINS=                                # Comma-separated list of allowed CORS origins

# Database
DATABASE_CONNECTION_STRING=                  # [required] Postgres connection string

# Irmin Core API (upstream)
IRMIN_API_BASE_URL=http://localhost:8082     # [required] Base URL of the Irmin Core API
IRMIN_API_TOKEN=                             # [required] System token for authenticating to the Core API

# Connectors
UNIVERSAL_CONNECTOR_API_KEY=                 # Shared API key used by all connectors

# Sentry (optional — leave blank to disable)
SENTRY_ENABLED=false                         # Master toggle (default false)
SENTRY_DSN=                                  # Sentry DSN
SENTRY_ENVIRONMENT=development               # Logical environment tag
SENTRY_TRACES_SAMPLE_RATE=0.1                # Traces sample rate (0.0–1.0)
