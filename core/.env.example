# Server Configuration
PORT=8082 # Port to run the API server on
URL=http://localhost:8082 # Public URL of the API server; also used as the base URL for webhook URLs (e.g., connector subscriptions)
CONSOLE_URL=https://console.irmin.dev # URL of the Irmin Console
TOKEN=random-api-system-token-here # Token to authenticate system requests to the API - should match LAKEFS_ACTIONS_ENV_IRMIN_API_TOKEN in docker-compose.yml; generate with: openssl rand -base64 32
ENV=development # Logical environment name, forwarded to child processes (Sentry fallback, etc.)

# AI Service Configuration
AI_SERVICE_BASE_URL=http://localhost:3001
AI_SERVICE_SYSTEM_TOKEN=system-token-from-ai-service # Must match AI_API_SYSTEM_TOKEN in ai/.env; generate with: openssl rand -base64 32
OPENAI_API_KEY=your-openai-api-key

# MCP Endpoint
MCP_HTTP_PATH=/mcp # Mount path for the embedded MCP server (streamable HTTP)

# Days until invites expire
INVITE_EXPIRES_IN_DAYS=7 # Number of days before an invite expires

# Performance & Security
HELMET_ENABLED=true # Enable helmet
IDEMPOTENCY_ENABLED=true # Enable idempotency
CORS_ENABLED=true # Enable CORS
ALLOWED_ORIGINS=https://console.irmin.dev,https://connectors.irmin.dev # Allowed origins for CORS
SIGNED_URL_SECRET=random-signed-url-secret-here # HMAC secret for signed download URLs; generate with: openssl rand -base64 32

# Credential Encryption (at-rest encryption for connection secrets and OAuth tokens)
# JSON array of {id, key_b64}. First entry is the active key; all entries remain valid for decryption.
# The key bytes must decode to 32 bytes (AES-256). Accepted encodings for key_b64:
#   - standard base64 (with or without padding) — e.g., `openssl rand -base64 32`
#   - URL-safe base64 (with or without padding)
#   - hex (64 chars) — e.g., `openssl rand -hex 32`
# Surrounding whitespace and trailing newlines are trimmed automatically.
# Leave unset in dev to run without encryption (a warning is logged at startup).
CREDENTIAL_ENCRYPTION_KEYS=[{"id":"k1","key_b64":"REPLACE_WITH_32_BYTE_BASE64_KEY"}]
REQUIRE_ENCRYPTION_AT_REST=false # When true, boot fails if CREDENTIAL_ENCRYPTION_KEYS is missing

# File Size Management (optional, in MB)
MAX_REQUEST_BODY_SIZE_MB=100 # Maximum request body size (default: 100)
MAX_IN_MEMORY_SIZE_MB=20 # Max file size to load fully into memory (default: 20)
MAX_STREAM_SIZE_MB=500 # Max file size for streaming through API (default: 500)
MAX_ASYNC_JOB_SIZE_MB=5000 # Size above which async jobs are required (default: 5000)
MAX_WORKFLOW_INPUT_FILE_SIZE_MB=500 # Max input file size for workflow actions (default: 500)

# Features
ORCHESTRATOR_ENABLED=true # Enable the orchestrator
SQID_ALPHABET=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890 # Alphabet to use for SQIDs

# Daytona (Compute Sandbox)
DAYTONA_API_KEY=... # Daytona API Key
DAYTONA_API_URL=https://daytona.irmin.dev # Daytona API URL

# Database
DATABASE_CONNECTION_STRING=postgresql://user:pwd@localhost:5432/irmin # Postgres DB connection string

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_... # Clerk Secret API Key
CLERK_SIGNING_KEY=... # Clerk Signing Key for JWT
CLERK_SIGNING_ALGORITHM=HS512 # Clerk Signing Algorithm for JWT

# Notification Service
NOVU_SECRET_KEY=abc123 # Novu secret key

# LakeFS (Data Versioning)
LAKE_FS_URL=https://lake.irmin.dev # URL of the Lake FS instance for versioning
LAKE_FS_ACCESS_KEY_ID=... # Access key ID for the Lake FS instance
LAKE_FS_SECRET_ACCESS_KEY=... # Secret access key for the Lake FS instance
LAKE_FS_S3_BUCKET=lakefs # Bucket name used by Lake FS for storing repositories

# Bucket name used by Irmin for storing non-repository objects
IRMIN_S3_BUCKET=irmin 

# S3-Compatible Object Storage
S3_ENDPOINT=https://ams3.digitaloceanspaces.com # Endpoint of the S3-compatible object store
S3_REGION=us-east-1 # Region of the S3-compatible object store
S3_ACCESS_KEY_ID=... # Access key ID for the S3-compatible object store
S3_ACCESS_SECRET=... # Secret access key for the S3-compatible object store

# DuckDB Configuration
SKIP_OPTIONAL_DUCKDB_EXTENSIONS=true # Skip optional extensions (e.g. parquet, orc)

# Sentry — all vars below are OPTIONAL. Leave blank to disable Sentry entirely.
# Flip SENTRY_ENABLED to "true" + set a DSN to report errors.
SENTRY_ENABLED=false                                    # [optional] master toggle (default: false)
SENTRY_DSN=https://...ingest.de.sentry.io/...           # [optional; required if enabled=true] Sentry DSN (write-only, public — safe to commit once you replace the placeholder with your own)
SENTRY_ENVIRONMENT=development                          # [optional] logical environment (default: "development")
SENTRY_ORG=irmin-dw                                     # [optional] Sentry org slug (public) — only used by release tagging / CI scripts
SENTRY_PROJECT=irmin-core                               # [optional] Sentry project slug (public) — only used by release tagging / CI scripts
SENTRY_TRACES_SAMPLE_RATE=0.1                           # [optional] transaction sampling (0.0-1.0, default: 0.1)

# Billing (Polar.sh)
BILLING_ENABLED=false # Enable billing features (subscription management, usage tracking)
POLAR_API_KEY=... # Polar API key for managing customers and subscriptions
POLAR_WEBHOOK_SECRET=whsec_... # Standard Webhooks secret for verifying Polar webhook signatures
POLAR_PRODUCT_ID=... # Polar product ID for the usage-based plan
POLAR_BASE_URL=https://api.polar.sh # Polar API base URL (use https://sandbox-api.polar.sh for sandbox)

# Connector OAuth Client Seeds (optional)
# Seed global OAuth client rows for connectors that need static OAuth credentials.
# Use with: go run main.go -seed-oauth-clients
# Multiple connectors can share the same redirect URI.
# Each connector uses its own env prefix (e.g. GOOGLE_DRIVE_*).
GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-oauth-client-secret
CONNECTOR_OAUTH_REDIRECT_URI=https://your-domain.com/api/v1/connectors/oauth/callback

# Test Environment (optional — only needed for running e2e / integration tests locally; safe to leave unset in normal development and production)
TEST_OBJECT_NAME=test.json # Name of an existing JSON object in the test repository that tests read against
TEST_USER_EMAIL=test@irmin.dev # Email of the pre-seeded test user used to authenticate test runs
TEST_WORKSPACE=test-workspace # Slug of the workspace the tests operate on
TEST_REPOSITORY=test-repository # Name of the repository within the test workspace used by tests
TEST_BRANCH=dev # Branch within the test repository that tests read/write against
