{
  "name": "irmin-ai",
  "version": "1.0.0",
  "description": "Irmin AI applications, with Langchain",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "pnpm typecheck && pnpm lint:fix && tsup",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "validate": "pnpm typecheck && pnpm lint:fix",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write src/**/*.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "clean": "rimraf dist",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org irmin-dw --project irmin-ai ./dist && sentry-cli sourcemaps upload --org irmin-dw --project irmin-ai ./dist"
  },
  "author": "Tim Borovkov / Irmin",
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "@ai-sdk/langchain": "^1.0.59",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/middie": "^9.0.3",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@h1deya/langchain-mcp-tools": "^0.3.8",
    "@langchain/anthropic": "^0.3.29",
    "@langchain/community": "^0.3.57",
    "@langchain/core": "^0.3.78",
    "@langchain/groq": "^0.2.4",
    "@langchain/langgraph": "^0.4.9",
    "@langchain/openai": "^0.6.14",
    "@langchain/qdrant": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@sentry/cli": "^2.56.0",
    "@sentry/node": "^10.17.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.1",
    "langsmith": "^0.3.71",
    "node-html-parser": "^7.0.1",
    "postgres": "^3.4.7",
    "zod": "^4.1.11",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@swc/core": "^1.13.5",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.6.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "prettier": "^3.3.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.45.0"
  },
  "engines": {
    "node": ">=22.10.0"
  }
}
