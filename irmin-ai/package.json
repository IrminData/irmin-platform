{
  "name": "irmin-ai",
  "version": "1.0.0",
  "description": "Irmin AI applications, with Langchain",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "pnpm typecheck && pnpm lint:fix && tsup",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "validate": "pnpm typecheck && pnpm lint:fix",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write src/**/*.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "migrate:ulid": "tsx scripts/migrate-uuids-to-ulid.ts",
    "clean": "rimraf dist",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org irmin-dw --project irmin-ai ./dist && sentry-cli sourcemaps upload --org irmin-dw --project irmin-ai ./dist"
  },
  "author": "Tim Borovkov / Irmin",
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/swagger": "^9.6.0",
    "@fastify/swagger-ui": "^5.2.3",
    "@langchain/anthropic": "^1.3.3",
    "@langchain/core": "^1.1.8",
    "@langchain/groq": "^1.0.0",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@langchain/mcp-adapters": "^1.1.1",
    "@langchain/openai": "^1.2.0",
    "@qdrant/js-client-rest": "^1.16.2",
    "@sentry/cli": "^3.0.1",
    "@sentry/node": "^10.32.1",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.6.2",
    "langchain": "^1.2.3",
    "langsmith": "^0.4.2",
    "postgres": "^3.4.7",
    "ulid": "^2.3.0",
    "uuid": "^13.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "knip": "^5.61.0",
    "@swc/core": "^1.15.7",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/node": "^25.0.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "tsup": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "engines": {
    "node": ">=24"
  }
}
