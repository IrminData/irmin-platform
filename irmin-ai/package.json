{
  "name": "irmin-ai",
  "version": "1.0.0",
  "description": "Irmin AI applications, with Langchain",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "pnpm typecheck && pnpm lint:fix && tsup",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "validate": "pnpm typecheck && pnpm lint:fix && knip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write src/**/*.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "migrate:ulid": "tsx scripts/migrate-uuids-to-ulid.ts",
    "clean": "rimraf dist",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "sentry:sourcemaps": "node scripts/upload-sourcemaps.mjs",
    "prepare": "husky"
  },
  "author": "Tim Borovkov / Irmin",
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@langchain/anthropic": "^1.3.26",
    "@langchain/core": "^1.1.40",
    "@langchain/groq": "^1.2.0",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.4",
    "@qdrant/js-client-rest": "^1.17.0",
    "@sentry/cli": "^3.3.5",
    "@sentry/node": "^10.49.0",
    "@sentry/profiling-node": "^10.49.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "langchain": "^1.3.3",
    "langsmith": "^0.5.20",
    "postgres": "^3.4.9",
    "ulid": "^3.0.2",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@swc/core": "^1.15.26",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.2.1",
    "husky": "^9.1.7",
    "knip": "^6.4.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2"
  },
  "engines": {
    "node": ">=24"
  }
}
