# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/irmin_ai

# AI Provider Configurations
GROQ_API_KEY=your-api-key
OPENAI_API_KEY=your-api-key

# Irmin API
IRMIN_API_BASE_URL=https://irmin-development.up.railway.app

# Langsmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-api-key
LANGSMITH_PROJECT=my-custom-project

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=optional-api-key

# CORS Configuration
CORS_ORIGINS=https://console.irmin.co,https://api.irmin.co
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=info
SENTRY_DSN=https://your-sentry-dsn-url.de.sentry.io/1234
SENTRY_AUTH_TOKEN=your-sentry-auth-token