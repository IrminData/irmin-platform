# ==============================================================================
# Irmin Console — Environment Variables
# ==============================================================================
# All NEXT_PUBLIC_* variables are inlined into the browser bundle at BUILD time
# and are also readable on the server. Every other variable below is SERVER-ONLY
# and read at runtime (middleware, API routes, server components).
# Never put secrets behind the NEXT_PUBLIC_ prefix.
# ==============================================================================

# Basic settings
NEXT_PUBLIC_BASE_URL=https://console.irmin.dev   # [build-time, client] Base URL of the console
NEXT_PUBLIC_WEBSITE_URL=https://irmin.dev        # [build-time, client] Marketing site URL (used in nav + sign-in/up/invite screens)
NEXT_PUBLIC_API_DOCS_URL=https://docs.irmin.dev  # [build-time, client] API docs URL (linked from workspace settings)
NODE_ENV=development                             # [runtime, server] development | production | test (Node.js convention — for logical env names like "staging", set SENTRY_ENVIRONMENT instead)
NEXT_PUBLIC_REVALIDATE="60"                      # [build-time, client] ISR revalidation time in seconds

# Features
NEXT_PUBLIC_BILLING_DISABLED=false               # [build-time, client] Set to "true" to hide billing UI (subscription management, usage tracking)

# Vercel / Corepack (build host — not read by app code)
ENABLE_EXPERIMENTAL_COREPACK=1                   # [build-time, platform] Enables corepack on Vercel builds. Leave as-is unless you know why you'd change it.

# API settings
NEXT_PUBLIC_API_URL=https://api.irmin.dev/api    # [build-time, client] Irmin Core API base URL (used by IrminCore on both server and browser)
NEXT_PUBLIC_AI_API_URL="https://ai-api.irmin.dev"  # [build-time, client] Irmin AI API base URL

# Uploads
NEXT_PUBLIC_PRESIGNED_UPLOAD_THRESHOLD_MB=20     # [build-time, client] File size (MB) at which the uploader switches to presigned S3 uploads instead of routing through the API

# Environment authentication (eg. password protection for staging/preview)
# All three vars below are server-side only (middleware + API route) and runtime.
REQUIRE_ENV_AUTH=false                           # [runtime, server] Enable environment-specific password protection (default: false)
ENV_PASSWORD=                                    # [runtime, server] Password for environment authentication
HMAC_SECRET=                                     # [runtime, server] HMAC signing key for env access cookie (falls back to ENV_PASSWORD); generate with: openssl rand -base64 32

# Sentry — all vars below are OPTIONAL. Leave blank to disable Sentry entirely.
# Flip NEXT_PUBLIC_SENTRY_ENABLED to "true" + set a DSN to report errors.
NEXT_PUBLIC_SENTRY_ENABLED=false                          # [optional] master toggle (default: false)
NEXT_PUBLIC_SENTRY_DSN=https://...ingest.de.sentry.io/...  # [optional; required if enabled=true] Sentry DSN (shared server + client; write-only, public — safe to commit once you replace the placeholder with your own)
SENTRY_ENVIRONMENT=development                            # [optional] logical environment, falls back to NODE_ENV
# Source map upload (production builds). ALL THREE must be set to upload;
# if any is missing, the build skips upload silently — no warnings, no failures.
SENTRY_ORG=irmin-dw                                       # [optional; required to upload source maps] Sentry org slug (public)
SENTRY_PROJECT=irmin-console                              # [optional; required to upload source maps] Sentry project slug (public)
SENTRY_AUTH_TOKEN=                                        # [optional; required to upload source maps] Sentry auth token
SENTRY_URL=https://sentry.io/                             # [optional] override for self-hosted / EU / private-cloud Sentry
# Sampling (all optional, sensible production defaults shown)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.15                # [optional] browser transaction sampling (0.0-1.0)
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1        # [optional] session replay sampling (0.0-1.0)
NEXT_PUBLIC_SENTRY_REPLAYS_ERROR_SAMPLE_RATE=1.0          # [optional] session replay on error (0.0-1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1                             # [optional] server transaction sampling (0.0-1.0)
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.1                    # [optional] continuous profiling session sampling (0.0-1.0); replaces deprecated SENTRY_PROFILES_SAMPLE_RATE
SENTRY_SUPPRESS_TURBOPACK_WARNING=1                       # [optional] suppress @sentry/nextjs Turbopack warning

# Posthog key for analytics
NEXT_PUBLIC_POSTHOG_KEY="phc_abc123" # Posthog project key
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com" # Posthog host URL

# Clerk for authentication
# CLERK_SECRET_KEY is not referenced in our code — the Clerk Next.js SDK reads
# it from process.env automatically on the server. Keep it set in every env.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY  # [build-time, client] Clerk publishable key
CLERK_SECRET_KEY=YOUR_SECRET_KEY                       # [runtime, server] Clerk secret key (auto-read by Clerk SDK)

# Novu for notifications
# NOVU_SECRET_KEY is auto-read by the Novu SDK — same pattern as Clerk.
NEXT_PUBLIC_NOVU_APP_ID=1234                           # [build-time, client] Novu application ID
NOVU_SECRET_KEY=abc123                                 # [runtime, server] Novu secret key (auto-read by Novu SDK)

# Environment variables for E2E testing (only used by Playwright)
TEST_USER_EMAIL=example@example.com                            # Irmin user email to run tests with
TEST_USER_PASSWORD=12345678                                    # Irmin user password to run tests with
TEST_USER_WORKSPACE="Example Core"                             # Workspace available for the test user
TEST_USER_WORKSPACE_SLUG="example-core"                        # Slug of the workspace available for the test user
TEST_USER_REPOSITORY="KPIs and Performance Metrics"            # Repository available for the test user
TEST_USER_REPOSITORY_SLUG="kpi-and-performance-metrics"        # Slug of the repository available for the test user