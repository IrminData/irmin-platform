  "devDependencies": {
    "@clerk/types": "^4.28.0",
    "@playwright/test": "^1.48.1",
    "@sentry/types": "^8.35.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/eslint": "9.6.1",
    "@types/node": "^22.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "8.11.0",
