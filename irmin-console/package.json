{
  "name": "irmin-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https",
    "build": "yarn docs && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "docs": "typedoc --entryPointStrategy expand ./src",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:codegen": "playwright codegen --load-storage=playwright/.auth/auth.json https://localhost:3000/en",
    "e2e:codegen-mobile": "playwright codegen --load-storage=playwright/.auth/auth.json --device=\"iPhone 12\" https://localhost:3000/en"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.9.2",
    "@clerk/themes": "^2.2.2",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/view": "^6.35.3",
    "@cyntler/react-doc-viewer": "^1.17.0",
    "@mdxeditor/editor": "^3.20.0",
    "@melloware/react-logviewer": "^6.1.0",
    "@microlink/react-json-view": "^1.23.4",
    "@novu/node": "^2.0.5",
    "@novu/react": "^2.6.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dropdown-menu": "^2.1.3",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.5",
    "@sentry/nextjs": "^8.45.0",
    "@uiw/codemirror-theme-vscode": "^4.23.7",
    "@uiw/react-codemirror": "^4.23.6",
    "@xyflow/react": "^12.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "markdown-to-jsx": "^7.7.1",
    "next": "15.1.0",
    "next-themes": "^0.4.4",
    "react": "19.0.0",
    "react-datasheet-grid": "^4.11.5",
    "react-day-picker": "^9.4.4",
    "react-diff-viewer": "^3.1.1",
    "react-dom": "19.0.0",
    "react-icons": "^5.4.0",
    "react-responsive": "^10.0.0",
    "react-select": "^5.9.0",
    "react-to-pdf": "^1.0.1",
    "rrule": "^2.8.1",
    "sharp": "^0.33.5",
    "styled-components": "^6.1.13",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@clerk/types": "^4.39.4",
    "@playwright/test": "^1.49.1",
    "@sentry/types": "^8.45.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.0",
    "@types/eslint": "9.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "19.0.0-beta-37ed2a7-20241206",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-compiler": "19.0.0-beta-37ed2a7-20241206",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.16",
    "typedoc": "^0.27.5",
    "typedoc-plugin-missing-exports": "^3.1.0",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=22",
    "npm": "please-use-yarn"
  },
  "packageManager": "yarn@4.5.3"
}
