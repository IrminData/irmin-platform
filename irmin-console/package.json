    "tailwindcss": "^3.4.14",
    "typedoc": "^0.26.10",
    "typedoc-plugin-missing-exports": "^3.0.0",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=22",
    "npm": "please-use-yarn"
  },
  "packageManager": "yarn@4.5.1"
