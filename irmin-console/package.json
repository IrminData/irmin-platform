{
  "name": "irmin-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev-ssl": "next dev --experimental-https",
    "build": "yarn docs && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "docs": "typedoc --entryPointStrategy expand ./src",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:codegen": "playwright codegen --load-storage=playwright/.auth/auth.json https://localhost:3000/en",
    "e2e:codegen-mobile": "playwright codegen --load-storage=playwright/.auth/auth.json --device=\"iPhone 12\" https://localhost:3000/en"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/view": "^6.34.1",
    "@cyntler/react-doc-viewer": "^1.17.0",
    "@mdxeditor/editor": "^3.14.0",
    "@melloware/react-logviewer": "^5.2.3",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@sentry/nextjs": "^8.33.1",
    "@uiw/codemirror-theme-github": "^4.23.5",
    "@uiw/react-codemirror": "^4.23.5",
    "@xyflow/react": "^12.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.451.0",
    "markdown-to-jsx": "^7.5.0",
    "next": "14.3.0-canary.87",
    "next-themes": "^0.3.0",
    "react": "19.0.0-rc.0",
    "react-datasheet-grid": "^4.11.4",
    "react-diff-viewer": "^3.1.1",
    "react-dom": "19.0.0-rc.0",
    "react-icons": "^5.3.0",
    "react-responsive": "^10.0.0",
    "react-select": "^5.8.1",
    "react-to-pdf": "^1.0.1",
    "sharp": "^0.33.5",
    "styled-components": "^6.1.13",
    "tailwind-merge": "^2.5.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/eslint": "8.56.12",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "8.8.1",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "sass": "^1.79.4",
    "tailwindcss": "^3.4.13",
    "typedoc": "^0.26.8",
    "typedoc-plugin-missing-exports": "^3.0.0",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20",
    "npm": "please-use-yarn"
  },
  "packageManager": "yarn@4.5.0"
}
