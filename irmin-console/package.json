    "react-responsive": "^10.0.1",
    "react-select": "^5.10.1",
    "react-to-pdf": "^2.0.0",
    "rrule": "^2.8.1",
    "sharp": "^0.33.5",
    "styled-components": "^6.1.16",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@clerk/types": "^4.50.1",
    "@playwright/test": "^1.51.1",
    "@sentry/types": "^9.10.1",
