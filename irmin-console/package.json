{
  "name": "irmin-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev-ssl": "next dev --experimental-https",
    "build": "yarn docs && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "docs": "typedoc --entryPointStrategy expand ./src",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:codegen": "playwright codegen --load-storage=playwright/.auth/auth.json https://localhost:3000/en",
    "e2e:codegen-mobile": "playwright codegen --load-storage=playwright/.auth/auth.json --device=\"iPhone 12\" https://localhost:3000/en"
  },
  "dependencies": {
    "@codemirror/lang-php": "^6.0.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-sql": "^6.7.1",
    "@codemirror/view": "^6.33.0",
    "@cyntler/react-doc-viewer": "^1.17.0",
    "@mdxeditor/editor": "^3.11.5",
    "@melloware/react-logviewer": "^5.2.2",
    "@radix-ui/react-icons": "^1.3.0",
    "@sentry/nextjs": "^8",
    "@uiw/codemirror-theme-github": "^4.23.3",
    "@uiw/react-codemirror": "^4.23.3",
    "@xyflow/react": "^12.3.0",
    "chart.js": "^4.4.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "markdown-to-jsx": "^7.5.0",
    "next": "^14.2.13",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-data-table-component": "^7.6.2",
    "react-datasheet-grid": "^4.11.4",
    "react-diff-viewer": "^3.1.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-responsive": "^10.0.0",
    "react-select": "^5.8.1",
    "react-to-pdf": "^1.0.1",
    "sharp": "^0.33.5",
    "styled-components": "^6.1.13",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/eslint": "8.56.12",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.13",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "sass": "^1.79.3",
    "tailwindcss": "^3.4.12",
    "typedoc": "^0.26.7",
    "typedoc-plugin-missing-exports": "^3.0.0",
    "typescript": "5.6.2"
  },
  "engines": {
    "node": ">=20",
    "npm": "please-use-yarn"
  },
  "packageManager": "yarn@4.5.0"
}
