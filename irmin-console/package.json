    "@uiw/react-codemirror": "^4.23.0",
    "chart.js": "^4.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "next": "^14.2.5",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-data-table-component": "^7.6.2",
    "react-datasheet-grid": "^4.11.4",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-responsive": "^10.0.0",
