  "scripts": {
    "dev": "next dev --experimental-https",
    "dev:no-https": "next dev",
    "build": "pnpm docs && next build",
    "start": "next start",
    "validate": "tsc --noEmit && prettier --write . && eslint --fix . && knip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "docs": "typedoc --entryPointStrategy expand ./src",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:codegen": "playwright codegen --load-storage=playwright/.auth/auth.json https://localhost:3000/en",
    "e2e:codegen-mobile": "playwright codegen --load-storage=playwright/.auth/auth.json --device=\"iPhone 12\" https://localhost:3000/en",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "dict:validate": "tsx scripts/dict-validate.ts",
    "dict:fix": "tsx scripts/dict-validate.ts --fix",
    "dict:report": "tsx scripts/dict-validate.ts --json",
    "prepare": "husky"
  },
