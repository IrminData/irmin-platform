# Server Configuration
PORT=3000
HOST=0.0.0.0
URL=http://localhost:3000                      # Public URL for Swagger / self-references. Default in code: http://localhost:3000
NODE_ENV=development                            # development | production | test
AI_API_SYSTEM_TOKEN=generate-api-key-for-internal-calls # Random API key for internal system requests; generate with: openssl rand -base64 32

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/irmin_ai

# AI Provider Configurations
GROQ_API_KEY=your-api-key
OPENAI_API_KEY=your-api-key
ANTHROPIC_API_KEY=your-api-key

# Irmin API
IRMIN_API_BASE_URL=https://irmin-development.up.railway.app
IRMIN_SYSTEM_TOKEN=core-api-system-token-here   # Must match TOKEN in core/.env; generate with: openssl rand -base64 32

# Langsmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-api-key
LANGSMITH_PROJECT=my-custom-project

# Qdrant vector store
QDRANT_URL=http://localhost:6333                # Must include http:// or https:// prefix
QDRANT_PORT=6333                                # Port used by the Qdrant client (defaults to 6333)
QDRANT_API_KEY=optional-api-key                 # Only required for hosted / auth-enabled Qdrant

# CORS Configuration
CORS_ORIGINS=https://console.irmin.co,https://api.irmin.co
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=info

# Sentry — all vars below are OPTIONAL. Leave blank to disable Sentry entirely.
# Flip SENTRY_ENABLED to "true" + set a DSN to report errors.
SENTRY_ENABLED=false                            # [optional] master toggle (default: false)
SENTRY_DSN=https://...ingest.de.sentry.io/...   # [optional; required if enabled=true] Sentry DSN (write-only, public — safe to commit once you replace the placeholder with your own)
SENTRY_ENVIRONMENT=development                  # [optional] logical environment, falls back to NODE_ENV
# Source map upload via `pnpm run sentry:sourcemaps` (prod builds only).
# ALL THREE of AUTH_TOKEN / ORG / PROJECT must be set to upload; otherwise
# the script no-ops silently — no warnings, no failures.
SENTRY_ORG=irmin-dw                             # [optional; required to upload source maps] Sentry org slug (public)
SENTRY_PROJECT=irmin-ai                         # [optional; required to upload source maps] Sentry project slug (public)
SENTRY_AUTH_TOKEN=                              # [optional; required to upload source maps] Sentry auth token
SENTRY_URL=https://sentry.io/                   # [optional] override for self-hosted / EU / private-cloud Sentry
SENTRY_TRACES_SAMPLE_RATE=0.1                   # [optional] transaction sampling (0.0-1.0)
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.1          # [optional] continuous profiling session sampling (0.0-1.0); replaces deprecated SENTRY_PROFILES_SAMPLE_RATE

# Testing
TEST_IRMIN_AUTH_TOKEN=cred_123456789
TEST_WORKSPACE_SLUG=demo-workspace
