{
  "name": "irmin-ai",
  "version": "1.0.0",
  "description": "Irmin AI applications, with Langchain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IrminData/irmin-platform.git",
    "directory": "ai"
  },
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "pnpm typecheck && pnpm lint:fix && tsup",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "validate": "pnpm typecheck && pnpm lint:fix && knip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write src/**/*.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "migrate:ulid": "tsx scripts/migrate-uuids-to-ulid.ts",
    "clean": "rimraf dist",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "sentry:sourcemaps": "node scripts/upload-sourcemaps.mjs",
    "prepare": "husky"
  },
  "author": "Tim Borovkov / Irmin",
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.1.48",
    "@langchain/groq": "^1.2.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.7",
    "@qdrant/js-client-rest": "^1.18.0",
    "@sentry/cli": "^3.4.3",
    "@sentry/node": "^10.53.1",
    "@sentry/profiling-node": "^10.53.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "langchain": "^1.4.2",
    "langsmith": "^0.7.2",
    "postgres": "^3.4.9",
    "ulid": "^3.0.2",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@swc/core": "^1.15.33",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.3.0",
    "husky": "^9.1.7",
    "knip": "^6.14.2",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "engines": {
    "node": ">=24"
  }
}
