{
  "name": "irmin-ai",
  "version": "1.0.0",
  "description": "Irmin AI applications, with Langchain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IrminData/irmin-platform.git",
    "directory": "ai"
  },
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "pnpm typecheck && pnpm lint:fix && tsup",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "validate": "pnpm typecheck && pnpm lint:fix && knip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write src/**/*.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "migrate:ulid": "tsx scripts/migrate-uuids-to-ulid.ts",
    "clean": "rimraf dist",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "sentry:sourcemaps": "node scripts/upload-sourcemaps.mjs",
    "prepare": "husky"
  },
  "author": "Tim Borovkov / Irmin",
  "packageManager": "pnpm@11.18.0+sha512.M9g8d9qC9J+6g2klxvG4QRgewxMrZwY5vQEvcHX1x89jTF+HAUfBmq50ePrAHfCdiJLogEVIlu3SPumzN1dWPA==",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.4",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.5.5",
    "@qdrant/js-client-rest": "^1.18.0",
    "@sentry/cli": "^3.6.2",
    "@sentry/node": "^10.69.0",
    "@sentry/profiling-node": "^10.69.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0",
    "langchain": "^1.5.4",
    "langsmith": "^0.8.9",
    "postgres": "^3.4.9",
    "ulid": "^3.0.2",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@swc/core": "^1.15.47",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "husky": "^9.1.7",
    "knip": "^6.31.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0"
}
